{
    "name": "silverday/clearstats",
    "description": "Self-hosted, multi-site, GDPR-compliant, cookieless web analytics platform.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-redis": "*",
        "maxmind-db/reader": "^1.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "ClearStats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClearStats\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
